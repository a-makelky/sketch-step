{
  "entities": {
    "Tutorial": {
      "title": "Tutorial",
      "description": "A drawing tutorial generated by AI.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "The UID of the user who created it, or null for guests." },
        "title": { "type": "string" },
        "finalImageUrl": { "type": "string" },
        "complexity": { "type": "string", "enum": ["simple", "moderate", "complex"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "order": { "type": "integer" },
              "imageUrl": { "type": "string" },
              "instruction": { "type": "string" }
            }
          }
        }
      },
      "required": ["title", "finalImageUrl", "complexity", "createdAt", "steps"]
    }
  },
  "firestore": {
    "/tutorials/{tutorialId}": {
      "schema": "Tutorial",
      "description": "Collection of drawing tutorials."
    }
  }
}
