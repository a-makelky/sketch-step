rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidTutorial(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.finalImageUrl is string &&
             data.complexity in ['simple', 'moderate', 'complex'] &&
             data.steps is list && data.steps.size() > 0 && data.steps.size() <= 20;
    }

    match /tutorials/{tutorialId} {
      // Anyone can create a tutorial (guests or users)
      allow create: if isValidTutorial(request.resource.data) && 
                    (request.resource.data.userId == null || request.resource.data.userId == request.auth.uid);
      
      // Anyone can read a tutorial if they have the ID (for sharing/guest view)
      allow read: if true;
      
      // Only owner can update or delete
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // List tutorials: Only if filtered by userId
      allow list: if isAuthenticated() && request.query.limit <= 50;
    }
  }
}
